{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/admin/api/(.*)",
      "dest": "/api/admin-$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin-$1"
    },
    {
      "src": "/admin",
      "dest": "/api/admin-index.php"
    },
    {
      "src": "/checkout",
      "dest": "/api/checkout.php"
    },
    {
      "src": "/order-success",
      "dest": "/api/order-success.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
